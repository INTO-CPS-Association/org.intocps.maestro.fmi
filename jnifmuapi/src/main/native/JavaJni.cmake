#Author Kenneth Lausdahl
include(TargetArch.cmake)


function(add_java_jni)
    if (DEFINED  ENV{CI})
        target_architecture(arch)
        if (UNIX AND NOT APPLE)
            if ("${arch}" STREQUAL "amd64" OR "${arch}" STREQUAL "x86_64")
                include_directories(${CMAKE_CURRENT_SOURCE_DIR}/../../../../third_party/jvm/linux64/include)
                include_directories(${CMAKE_CURRENT_SOURCE_DIR}/../../../../third_party/jvm/linux64/include/linux)
            else ()
                include_directories(${CMAKE_CURRENT_SOURCE_DIR}/../../../../third_party/jvm/linux32/include)
                include_directories(${CMAKE_CURRENT_SOURCE_DIR}/../../../../third_party/jvm/linux32/include/linux)
            endif ()
        elseif (APPLE)
            include_directories(${CMAKE_CURRENT_SOURCE_DIR}/../../../../third_party/jvm/darwin64/include)
            include_directories(${CMAKE_CURRENT_SOURCE_DIR}/../../../../third_party/jvm/darwin64/include/darwin)
        elseif (WIN32)
            set(OS_NAME "Win")
            if ("${arch}" STREQUAL "amd64" OR "${arch}" STREQUAL "x86_64")
                include_directories(${CMAKE_CURRENT_SOURCE_DIR}/../../../../third_party/jvm/win64/include)
                include_directories(${CMAKE_CURRENT_SOURCE_DIR}/../../../../third_party/jvm/win64/include/win32)
            else ()
                include_directories(${CMAKE_CURRENT_SOURCE_DIR}/../../../../third_party/jvm/win32/include)
                include_directories(${CMAKE_CURRENT_SOURCE_DIR}/../../../../third_party/jvm/win32/include/win32)
            endif ()
        endif ()
    else ()
        find_package(JNI REQUIRED)
        include_directories(${JNI_INCLUDE_DIRS})
    endif ()

endfunction()